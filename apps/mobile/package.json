{
  "name": "@dash/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DASH native client — one stable React Native app with Customer and Rider faces.",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "node scripts/ios-cli.mjs run",
    "ios:generate": "node scripts/ios-cli.mjs generate",
    "ios:bundle": "node scripts/ios-cli.mjs bundle",
    "ios:verify-config": "node scripts/verify-ios-config.mjs",
    "ios:verify-release": "node scripts/verify-ios-config.mjs --release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@dash/domain": "file:../../packages/domain",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "11.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "26.0.0",
    "@react-native-firebase/messaging": "26.0.0",
    "expo": "~57.0.31",
    "expo-build-properties": "57.0.22",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/plist": "0.8.1",
    "@types/react": "~19.2.4",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "expo-modules-core": {
      "react-native-worklets": "0.12.2"
    }
  },
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": ["expo-modules-core"]
      }
    }
  }
}
