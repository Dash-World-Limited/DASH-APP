<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The rider screen reports its position with `navigator.geolocation`, and
      dispatch refuses any rider whose last position is older than 120 seconds.
      Without these the WebView cannot obtain a fix at all: Capacitor already
      calls `setGeolocationEnabled(true)` and prompts for the runtime
      permission, but Android will not grant a permission the manifest does not
      declare — so the prompt never appears, the rider never reports, and every
      dispatch excludes them as `location_stale` with nothing on screen to
      explain why.

      Coarse as well as fine: if a tester grants only approximate location,
      dispatch still gets a usable fix rather than none.
    -->
    <!--
      Android 13+ requires this before a notification can be shown at all.

      Declared here rather than relied upon from the plugin: the push plugin's
      Java asks for POST_NOTIFICATIONS at runtime via its @Permission
      annotation, but its own manifest does not declare it. A runtime request
      for a permission the merged manifest never declared is refused
      immediately, without a prompt — so notifications would simply never
      arrive, with nothing in the app or the logs saying why. That is the same
      shape of silent failure as the geolocation secure-origin refusal, and it
      cost a round of physical testing to find last time.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
