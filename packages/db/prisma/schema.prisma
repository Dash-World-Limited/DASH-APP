// DASH APP — data model
//
// Authored to stay portable between SQLite (local development) and PostgreSQL
// + PostGIS (production). See ADR-0003. The rules that keep that door open:
//
//   * No SQLite-only features, no `Unsupported()` columns.
//   * Geometry is ordinary columns — Float lat/lng, JSON polygon rings — never
//     a PostGIS `geography` type here. Spatial logic lives behind `GeoPort`.
//   * Money is always `Int` (kobo). Never Decimal, never Float.
//   * Enums are `String` columns constrained by Zod at the API boundary,
//     because SQLite has no native enum. Postgres can promote them later.
//   * Every public identifier is a CUID, never a sequential integer, so ids
//     cannot be enumerated or used to infer volume.

generator client {
  provider = "prisma-client-js"
  // No custom `output`. npm workspaces hoist @prisma/client to the root
  // node_modules, and it resolves the generated client relative to itself — a
  // package-local output directory would generate a client nothing imports.
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Identity, sessions, permissions
// ===========================================================================

model Identity {
  id String @id @default(cuid())

  // E.164. Nullable because staff may sign in by email only.
  phone String? @unique
  email String? @unique

  /// When control of `email` was actually proved, by redeeming a code sent to
  /// it. Null means the address is claimed but unproven.
  ///
  /// The column, not the presence of an address, is what makes an account real:
  /// anybody can type a stranger's email into a signup form, and an unverified
  /// row must never be able to receive anything or act as that person. Sellers
  /// and Trusted Partners are separate privileged states on top of this, still
  /// granted only by an admin.
  ///
  /// There is deliberately no `phoneVerifiedAt`. SMS verification is switched
  /// off for V1, so a column recording it would be permanently null and read as
  /// though every phone number had failed verification rather than never having
  /// been asked to.
  emailVerifiedAt DateTime?

  // Only ever set for staff accounts. Customers and riders use OTP.
  passwordHash String?

  // --- Multi-factor authentication ---------------------------------------
  // Staff accounts must carry TOTP before they can reach the admin console.
  //
  // The secret is an AES-256-GCM envelope (see @dash/domain/envelope), bound to
  // this identity so a row copied to another identity fails to decrypt. It is
  // never returned by any read path once enrolment is confirmed.
  mfaSecretCipher String?

  // An enrolment that has been started but not yet proved. Kept separate from
  // the live secret so a half-finished enrolment can never authenticate, and so
  // starting a new one cannot lock out a working authenticator.
  mfaPendingCipher String?
  mfaPendingAt     DateTime?

  // Set only when possession has been proved. This, not the presence of a
  // secret, is what makes MFA active.
  mfaEnrolledAt DateTime?

  // Highest TOTP time step already accepted for this identity. A code is only
  // valid for a step strictly greater than this, so the same six digits cannot
  // be replayed inside their own validity window.
  mfaLastTimeStep Int?

  displayName String?
  locale      String  @default("en-NG")

  status String @default("active") // active | suspended | deleted

  // Denormalised flag mirroring the current AccountDeletionRequest: set while a
  // deletion is scheduled, cleared on cancellation. A fast "is this account
  // winding down?" check without a join.
  deletionRequestedAt DateTime?

  // Set once finalisation has anonymised this identity. Its presence makes
  // finalisation idempotent: a second run over an already-anonymised account
  // does nothing.
  anonymisedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles           IdentityRole[]
  sessions        Session[]
  devices         Device[]
  otpChallenges   OtpChallenge[]
  mfaChallenges   MfaChallenge[]
  mfaRecoveryCodes MfaRecoveryCode[]
  customer        Customer?
  rider           Rider?
  vendorUsers     VendorUser[]
  auditLogs       AuditLog[]
  legalAcceptances LegalAcceptance[]
  deletionRequests AccountDeletionRequest[]
  dataExportRequests DataExportRequest[]

  @@index([status])
  @@index([deletionRequestedAt])
}

// ===========================================================================
// Account deletion and data export
// ===========================================================================

/**
 * A request to delete an account, and its state over time.
 *
 * Deletion is never immediate. A request is created `scheduled` with a
 * `scheduledPurgeAt` a cooling-off window in the future; the owner can cancel
 * any time before that instant. A finalisation job then anonymises everything
 * the ledger references and deletes the rest — see @dash/domain/account.
 *
 * At most one non-terminal request per identity, enforced by a partial-unique
 * shape: `identityId` is unique here and the row is only ever deleted, never
 * kept in a terminal state alongside a new one. A completed or cancelled
 * request is retained as the record that it happened.
 */
model AccountDeletionRequest {
  id         String @id @default(cuid())
  identityId String

  status String @default("scheduled") // scheduled | held | cancelled | completed

  // The cooling-off window.
  requestedAt      DateTime @default(now())
  scheduledPurgeAt DateTime

  cancelledAt DateTime?
  completedAt DateTime?

  // Set when finalisation, re-checking legal holds at the last moment, finds a
  // hold acquired during the cooling-off period. The request parks in `held`
  // and every later maintenance run re-evaluates it. `heldReason` is a
  // non-sensitive hold code (open_order, payment_dispute, …).
  heldReason String?
  heldAt     DateTime?

  // Optional free text from the person. Bounded and never echoed into logs.
  reason String?

  // Who asked. `requestedBy` is the acting identity — the account holder for a
  // self-service request, a staff member for an admin-initiated one, in which
  // case it differs from `identityId` and the audit entry carries onBehalfOf.
  requestedBy       String
  requestedByIp     String?
  requestedByAgent  String?

  // Set when finalisation runs, so the job is idempotent on it.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  // One live request per identity. A terminal one is deleted before a new one
  // is accepted, so this never blocks a legitimate re-request.
  @@unique([identityId])
  @@index([status, scheduledPurgeAt])
}

/**
 * A request for a copy of an account's own personal data.
 *
 * Built asynchronously by a job into a single JSON archive held by
 * `ExportArchivePort`. The archive is downloadable exactly once, through an
 * authenticated route that checks a single-use token, and only until
 * `expiresAt`. After delivery or expiry the archive is deleted and the row
 * kept as the record that an export was made.
 */
model DataExportRequest {
  id         String @id @default(cuid())
  identityId String

  status String @default("pending") // pending | building | ready | delivered | expired | failed

  requestedAt DateTime @default(now())
  readyAt     DateTime?
  deliveredAt DateTime?
  expiresAt   DateTime?
  failedAt    DateTime?
  failureReason String?

  // Where the built archive lives, via ExportArchivePort. Null until ready,
  // and nulled again once the archive is deleted after download or expiry.
  storageKey String?
  sizeBytes  Int?
  format     String @default("json")

  // Atomic build claim. Exactly one worker moves a `pending` row to `building`
  // with its own `buildClaimId` before it reads any subject data or writes a
  // blob; the losing worker does nothing. A claim older than `buildClaimUntil`
  // is abandoned and may be reclaimed or failed. `buildAttempts` caps retries.
  buildClaimId    String?
  buildClaimUntil DateTime?
  buildAttempts   Int      @default(0)

  // The download authorisation is a signed, expiring capability token — see
  // apps/api/src/account/export.ts. Nothing about it is stored: it carries the
  // request id and an expiry and is verified by HMAC. Single use is enforced
  // here instead.
  //
  // 0 until the one permitted download happens, then 1. A guarded update makes
  // two concurrent downloads impossible.
  downloadCount Int @default(0)

  // A short exclusive lease held only while a download is streaming the archive
  // out of storage. It is taken before `archive.read` and released — leaving
  // the row `ready` and unused — if the read fails, so a transient storage
  // outage never consumes the one permitted download. The expiry lets a
  // crashed download be taken over.
  downloadLeaseId    String?
  downloadLeaseUntil DateTime?

  requestedByIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, status])
  @@index([status, expiresAt])
  @@index([status, buildClaimUntil])
}

model IdentityRole {
  id         String @id @default(cuid())
  identityId String
  role       String // matches Role in @dash/domain/permissions

  // Scope qualifiers. Which apply depends on the role.
  vendorId String?
  branchId String?
  cityId   String?

  grantedBy String?
  createdAt DateTime @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([identityId, role, vendorId, cityId])
  @@index([identityId])
  @@index([role])
}

model Session {
  id         String @id @default(cuid())
  identityId String

  // Only the SHA-256 of the refresh token is stored. A database leak must not
  // yield usable tokens.
  refreshTokenHash String @unique

  // Rotation lineage. If a token that was already rotated is presented again,
  // the whole family is revoked — that is a replay, meaning the token leaked.
  previousSessionId String?
  rotatedAt         DateTime?

  deviceId  String?
  ipAddress String?
  userAgent String?

  // Set when the user completes a step-up challenge. Read by assertPermission.
  steppedUpAt DateTime?

  // Populated when an admin is impersonating this identity, so every action
  // taken during the impersonation is attributable to the real actor.
  impersonatedBy String?

  expiresAt DateTime
  revokedAt DateTime?
  revokedReason String?

  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id])

  @@index([identityId])
  @@index([expiresAt])
}

model Device {
  id         String @id @default(cuid())
  identityId String

  platform     String // ios | android | web

  // Unique across the whole table, not per identity.
  //
  // An FCM token identifies a physical installation, and an installation
  // belongs to whoever is signed into it *now*. If the same token were allowed
  // on two identities, a phone that a rider borrowed and signed out of would
  // keep receiving that rider's offers alongside its new owner's — the push
  // would be delivered to the handset, not to the person. The constraint makes
  // that state unrepresentable rather than merely discouraged, so registration
  // has to rebind the token instead of adding a second claim on it.
  //
  // Nullable, and SQL permits many NULLs under a unique index, so a device row
  // that has revoked its token does not collide with every other revoked one.
  pushToken    String? @unique
  model        String?
  appVersion   String?

  trustedAt DateTime?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())

  identity Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([identityId])
}

model OtpChallenge {
  id         String  @id @default(cuid())
  identityId String?

  // The destination is stored so an OTP issued to one number cannot be redeemed
  // for another.
  destination String
  channel     String // sms | email

  // Hashed, never stored in clear. In development the plain code is logged to
  // the console instead; DEV_EXPOSE_OTP is hard-blocked in production.
  codeHash String

  purpose String // login | step_up | phone_change | delete_account

  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  identity Identity? @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([destination, purpose])
  @@index([expiresAt])
}

/**
 * A login that has passed the password stage and is waiting on TOTP.
 *
 * This is deliberately NOT a Session: no session exists until the second factor
 * succeeds, so a stolen intermediate token cannot be refreshed, cannot call any
 * business endpoint, and expires in minutes rather than days.
 */
model MfaChallenge {
  id         String @id @default(cuid())
  identityId String

  // Only the SHA-256 of the opaque challenge token is stored, for the same
  // reason refresh tokens are hashed: a database leak must not yield a usable
  // credential.
  tokenHash String @unique

  purpose String // login | step_up | disable | recovery_regenerate

  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?

  ipAddress String?
  userAgent String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, purpose])
  @@index([expiresAt])
}

/**
 * A single-use backup code for when the authenticator device is lost.
 *
 * Stored only as a hash. Because these are high-entropy random values rather
 * than user-chosen text, SHA-256 is the right construction — there is no
 * dictionary to attack, so a slow KDF would add cost without adding security.
 */
model MfaRecoveryCode {
  id         String @id @default(cuid())
  identityId String

  codeHash String @unique

  // Set the moment it is redeemed. Rows are retained rather than deleted so
  // "which code was used, and when" stays answerable during an investigation.
  usedAt    DateTime?
  usedIp    String?

  // Which generation this belongs to. Regenerating issues a new batch and
  // retires every unused code from earlier ones.
  batch     Int      @default(1)

  createdAt DateTime @default(now())

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId, usedAt])
}

// ===========================================================================
// Geography and market configuration
// ===========================================================================

model City {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  country  String @default("NG")
  currency String @default("NGN")
  timezone String @default("Africa/Lagos")

  // Straight-line to road-distance ratio for this city. Lagos differs from a
  // grid city; this is data, not a constant in code.
  detourFactor Float @default(1.4)

  centreLatitude  Float
  centreLongitude Float

  isLive    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones        Zone[]
  vendors      Vendor[]
  pricingRules PricingRule[]

  @@index([slug])
}

model Zone {
  id     String @id @default(cuid())
  cityId String
  name   String
  slug   String

  // GeoJSON-order ring: [[lng, lat], ...], or { outer, holes }.
  // Parsed by parsePolygon() in @dash/domain/geo. In PostgreSQL this becomes a
  // geography column with a GiST index; the JSON stays as the source of truth
  // for editing.
  polygon String

  // Cached bounding box — a cheap pre-filter before the exact polygon test.
  minLatitude  Float
  maxLatitude  Float
  minLongitude Float
  maxLongitude Float

  // Ops can pause a zone during a flood, a fuel shortage, or unrest.
  isActive    Boolean   @default(true)
  pausedAt    DateTime?
  pausedReason String?

  // Manual demand multiplier, capped by the city's pricing rule.
  surgeMultiplier Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city     City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  branches Branch[]
  orders   Order[]

  @@unique([cityId, slug])
  @@index([cityId, isActive])
}

model PricingRule {
  id      String  @id @default(cuid())
  cityId  String
  // Null = the city default. A zone-specific rule overrides it.
  zoneId  String?
  version String

  baseDeliveryFee       Int // kobo
  includedMetres        Int
  perKilometreFee       Int
  perMinuteFee          Int
  minimumDeliveryFee    Int
  maximumDeliveryFee    Int
  serviceFeeBasisPoints Int
  serviceFeeCap         Int
  smallOrderThreshold   Int
  smallOrderFee         Int
  taxBasisPoints        Int   @default(0)
  maximumSurgeMultiplier Float @default(2.0)

  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  createdBy String?
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, effectiveFrom])
}

// ===========================================================================
// Customers
// ===========================================================================

model Customer {
  id         String @id @default(cuid())
  identityId String @unique

  referralCode     String  @unique
  referredByCode   String?
  dietaryPreferences String? // JSON array

  marketingOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity      Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  subscriptions Subscription[]
  redemptions   PromotionRedemption[]

  // Declutter. Back-relations only — the foreign keys live on the Declutter
  // side, so the customers table itself is unchanged.
  declutterSeller          DeclutterSeller?
  declutterContactRequests DeclutterContactRequest[]

  @@index([referralCode])
}

model Address {
  id         String @id @default(cuid())
  customerId String

  label        String? // Home, Work
  line1        String
  landmark     String?
  instructions String?
  contactPhone String

  latitude  Float
  longitude Float

  isDefault Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
}

// ===========================================================================
// Vendors and catalogue
// ===========================================================================

model Vendor {
  id     String @id @default(cuid())
  cityId String

  name        String
  slug        String  @unique
  description String?
  category    String // restaurant | grocery | pharmacy | retail | market
  logoKey     String?
  coverKey    String?

  // KYB lifecycle.
  status          String    @default("pending") // pending | approved | suspended | rejected
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?

  // Commission in basis points, from the signed contract.
  commissionBasisPoints Int @default(1800)

  // Settlement destination. Account numbers are stored encrypted at rest by the
  // application layer; the raw value never appears in a log or an export.
  bankName          String?
  bankAccountLast4  String?
  bankAccountCipher String?

  // Auto-accept incoming orders after this many seconds. 0 disables it.
  autoAcceptSeconds Int @default(0)

  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city        City          @relation(fields: [cityId], references: [id])
  branches    Branch[]
  vendorUsers VendorUser[]
  categories  MenuCategory[]
  items       MenuItem[]
  orders      Order[]
  documents   VendorDocument[]
  reviews     Review[]

  @@index([cityId, status])
  @@index([category])
}

model Branch {
  id       String @id @default(cuid())
  vendorId String
  zoneId   String?

  name    String
  address String
  phone   String?

  latitude  Float
  longitude Float

  // How far this branch will deliver, on top of the zone rules.
  deliveryRadiusMetres Int @default(8000)

  // open | closed | busy — `busy` extends quoted prep times without going dark.
  state          String @default("closed")
  busyExtraMinutes Int  @default(0)

  supportsDelivery      Boolean @default(true)
  supportsPickup        Boolean @default(true)
  supportsVendorDelivery Boolean @default(false)

  minimumOrder         Int @default(0) // kobo
  defaultPrepMinutes   Int @default(20)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  zone   Zone?         @relation(fields: [zoneId], references: [id])
  hours  OperatingHour[]
  orders Order[]
  stock  ItemStock[]

  @@index([vendorId])
  @@index([zoneId, isActive])
}

model OperatingHour {
  id       String @id @default(cuid())
  branchId String

  dayOfWeek Int // 0 = Sunday
  // Minutes from midnight, local to the city's timezone. Integers rather than
  // times so an overnight window (22:00–02:00) is expressible as 1320–1560.
  opensAtMinute  Int
  closesAtMinute Int

  // A dated override for a holiday, closing early, etc.
  overrideDate DateTime?
  isClosed     Boolean   @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
}

model VendorUser {
  id         String @id @default(cuid())
  vendorId   String
  identityId String
  branchId   String?

  role String // vendor_owner | vendor_manager | vendor_staff

  invitedBy  String?
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([vendorId, identityId])
  @@index([identityId])
}

model VendorDocument {
  id       String @id @default(cuid())
  vendorId String

  kind      String // cac_certificate | tax_id | food_licence | owner_id
  // Random object key in a private bucket. Never a public URL.
  objectKey String
  mimeType  String
  sizeBytes Int

  status       String    @default("pending") // pending | approved | rejected
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectionReason String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
}

model MenuCategory {
  id       String @id @default(cuid())
  vendorId String

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())

  vendor Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([vendorId, isActive])
}

model MenuItem {
  id         String @id @default(cuid())
  vendorId   String
  categoryId String

  name        String
  description String?
  imageKey    String?

  // Second-hand condition, for Declutter listings. Null for everything else:
  // a plate of jollof has no condition, and overloading `description` with it
  // would make the field unqueryable and the data untrue.
  condition   String? // new | like_new | good | fair

  // Menu price in kobo. The server always re-reads this at checkout; a price
  // sent by a client is never trusted.
  price Int

  prepMinutes Int     @default(15)
  isAvailable Boolean @default(true)

  // Regulated items (pharmacy, alcohol) need an explicit acknowledgement.
  requiresAgeCheck Boolean @default(false)
  allergens        String? // JSON array

  sortOrder Int      @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  stock          ItemStock[]

  @@index([vendorId, isAvailable])
  @@index([categoryId])
}

model ModifierGroup {
  id     String @id @default(cuid())
  itemId String

  name        String
  // Enforced server-side at checkout, never only in the UI.
  minSelect   Int    @default(0)
  maxSelect   Int    @default(1)
  sortOrder   Int    @default(0)

  item    MenuItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options Modifier[]

  @@index([itemId])
}

model Modifier {
  id      String @id @default(cuid())
  groupId String

  name        String
  priceDelta  Int     @default(0) // kobo, may be negative
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ItemStock {
  id       String @id @default(cuid())
  itemId   String
  branchId String

  // Null means "not tracked" — a kitchen cooking to order. A number means a
  // finite count, decremented on order acceptance.
  quantity Int?

  isAvailable Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branch Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([itemId, branchId])
  @@index([branchId, isAvailable])
}

// ===========================================================================
// Riders
// ===========================================================================

model Rider {
  id         String @id @default(cuid())
  identityId String @unique

  status String @default("pending") // pending | approved | suspended | rejected

  vehicleType  String @default("motorcycle")
  vehiclePlate String?

  // Availability and presence.
  availability      String    @default("offline") // offline | idle | on_delivery | on_break
  lastLatitude      Float?
  lastLongitude     Float?
  locationReportedAt DateTime?

  // When this rider's Online claim expires, unless renewed.
  //
  // "Online" used to be a flag the client set once and nothing ever revoked. A
  // rider whose app was killed stayed `idle` for ever, so the only thing that
  // eventually stopped them being offered work was their position going stale —
  // and once a stale position may itself wake a rider (see the grace path in
  // the dispatch worker), that backstop is gone.
  //
  // The lease makes Online a claim the server can verify. It is pushed forward
  // on every accepted position report, so a living app never expires, and it is
  // cleared outright when a rider goes Offline deliberately.
  onlineUntil DateTime?

  qualityScore   Float     @default(80)
  lastAssignedAt DateTime?

  // Cash handling. A rider over their float cap stops being offered COD orders.
  canCarryCash   Boolean @default(false)
  cashFloatCap   Int     @default(0) // kobo
  cashFloatHeld  Int     @default(0) // kobo

  // Zones the rider may work. Empty = unrestricted.
  allowedZoneIds String? // JSON array

  approvedAt DateTime?
  approvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identity   Identity        @relation(fields: [identityId], references: [id], onDelete: Cascade)
  documents  RiderDocument[]
  offers     DispatchOffer[]
  orders     Order[]
  locations  RiderLocation[]

  @@index([availability, status])
}

model RiderDocument {
  id      String @id @default(cuid())
  riderId String

  kind      String // drivers_licence | national_id | vehicle_papers | passport_photo
  objectKey String
  mimeType  String
  sizeBytes Int

  status          String    @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  expiresAt       DateTime?

  createdAt DateTime @default(now())

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, status])
}

model RiderLocation {
  id      String @id @default(cuid())
  riderId String

  latitude  Float
  longitude Float
  accuracy  Float?
  heading   Float?
  speed     Float?

  // Set when the point failed the jump check, with the implied speed, so a
  // spoofing pattern can be investigated without polluting live tracking.
  rejectedReason String?

  recordedAt DateTime
  createdAt  DateTime @default(now())

  // Set once the retention job has coarsened this point. Its presence is what
  // makes the job converge: an already-anonymised row is skipped rather than
  // rounded again, so repeated and concurrent runs are no-ops.
  anonymisedAt DateTime?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  // Location history is coarsened on a retention schedule — see
  // docs/RETENTION.md and packages/domain/src/retention.
  @@index([riderId, recordedAt])
  // Drives the retention sweep: find old points not yet anonymised.
  @@index([recordedAt, anonymisedAt])
}

// ===========================================================================
// Carts and orders
// ===========================================================================

model Cart {
  id         String @id @default(cuid())
  customerId String
  branchId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  itemId String

  quantity     Int
  // JSON array of modifier ids. Re-priced server-side at checkout.
  modifierIds  String?
  instructions String?

  createdAt DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}

model Order {
  id     String @id @default(cuid())
  // Short human-readable reference for support calls, e.g. "DASH-7F3K2M".
  code   String @unique

  customerId String
  vendorId   String
  branchId   String
  addressId  String?
  zoneId     String?
  riderId    String?

  status String @default("draft")
  mode   String @default("delivery") // delivery | pickup | vendor_delivery

  // Monotonic counter, incremented in the same transaction as every change
  // worth telling a watching client about. It is the ordering for realtime
  // notifications and exists because nothing else here can be one.
  //
  // `updatedAt` cannot: two writes inside the same millisecond are
  // indistinguishable, and comparing wall clocks set by different instances
  // orders nothing at all. A notification wrongly judged "older than what I
  // have" is dropped, and the symptom is a screen that stays stale — the one
  // failure this whole milestone exists to prevent. A counter incremented
  // inside the transaction cannot have either problem.
  //
  // Never exposed to clients as a cursor; it is only ever compared with another
  // revision of the same order. See packages/domain/src/realtime.
  revision Int @default(0)

  // --- The quote, frozen at checkout -------------------------------------
  // Stored as individual columns for querying plus the full explained
  // breakdown as JSON, so a receipt can be reproduced exactly.
  itemsSubtotal   Int
  discountTotal   Int @default(0)
  deliveryFee     Int @default(0)
  serviceFee      Int @default(0)
  smallOrderFee   Int @default(0)
  surgeAmount     Int @default(0)
  tax             Int @default(0)
  tip             Int @default(0)
  walletApplied   Int @default(0)
  total           Int

  vendorFundedDiscount   Int @default(0)
  platformFundedDiscount Int @default(0)

  // Full QuoteLine[] and inputs, for dispute resolution.
  quoteBreakdown String
  pricingRuleVersion String

  // --- Trip ---------------------------------------------------------------
  distanceMetres Int?
  durationMinutes Int?
  distanceSource String?

  // --- Verification codes -------------------------------------------------
  // Hashed. A rider who can read the database still cannot complete a delivery
  // without the customer reading the PIN aloud.
  pickupCodeHash   String?
  deliveryPinHash  String?

  // --- Timing -------------------------------------------------------------
  scheduledFor  DateTime?
  placedAt      DateTime?
  acceptedAt    DateTime?
  readyAt       DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?

  estimatedReadyAt    DateTime?
  estimatedDeliveryAt DateTime?

  cancellationReason String?
  cancelledBy        String?

  contactless  Boolean @default(false)
  instructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id])
  vendor       Vendor              @relation(fields: [vendorId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id])
  address      Address?            @relation(fields: [addressId], references: [id])
  zone         Zone?               @relation(fields: [zoneId], references: [id])
  rider        Rider?              @relation(fields: [riderId], references: [id])
  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  offers       DispatchOffer[]
  payments     Payment[]
  reviews      Review[]
  proofs       DeliveryProof[]

  @@index([customerId, createdAt])
  @@index([vendorId, status])
  @@index([riderId, status])
  @@index([status, createdAt])
  @@index([zoneId, status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  itemId  String?

  // Denormalised deliberately. If the vendor renames or reprices the dish
  // tomorrow, the receipt must still show what was actually bought and paid.
  nameSnapshot  String
  priceSnapshot Int

  quantity     Int
  // JSON: [{ id, name, priceDelta }] — also snapshotted.
  modifiers    String?
  lineTotal    Int
  instructions String?

  // Retail/grocery substitution.
  substitutedForItemId String?
  substitutionNote     String?

  order Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  MenuItem? @relation(fields: [itemId], references: [id])

  @@index([orderId])
}

model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String

  fromStatus String?
  toStatus   String

  actorType String // customer | vendor | rider | ops | system
  actorId   String?
  reason    String?

  // Ops interventions carry a mandatory reason code.
  reasonCode String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model DeliveryProof {
  id      String @id @default(cuid())
  orderId String

  kind      String // photo | signature | pin_verified
  objectKey String?
  // Coarsened before storage — see coarsen() in @dash/domain/geo.
  latitude  Float?
  longitude Float?

  capturedAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ===========================================================================
// Dispatch
// ===========================================================================

model DispatchOffer {
  id      String @id @default(cuid())
  orderId String
  riderId String

  // Which eligibility rule produced this offer.
  //
  // `fresh` — the rider's position was inside the normal 120s window, and every
  // dispatch rule was satisfied at the moment of offering.
  //
  // `grace` — the position was older than 120s but inside the grace window, so
  // the offer exists only to *wake* the rider. A grace offer may never be
  // accepted on the strength of that stale position: the acceptance path
  // demands a fresh fix and re-validates distance and zone against it. Recorded
  // rather than inferred so the acceptance gate has something explicit to
  // branch on, and so grace conversion can be measured rather than guessed at.
  eligibilityMode String @default("fresh") // fresh | grace

  round  Int    @default(1)
  status String @default("pending") // pending | accepted | declined | expired | withdrawn

  score          Float
  // The full ScoreFactor[] that produced the score, so a dispatcher can answer
  // "why that rider?" from the record alone.
  scoreBreakdown String
  ruleVersion    String

  pickupEtaSeconds     Int
  pickupDistanceMetres Int

  expiresAt  DateTime
  respondedAt DateTime?
  declineReason String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([orderId, round])
  @@index([riderId, status])
  @@index([expiresAt])
}

// ===========================================================================
// Payments
// ===========================================================================

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider          String // mock | paystack
  providerReference String @unique

  amount   Int
  currency String @default("NGN")
  method   String // card | bank | wallet | cash

  status String @default("pending")

  // Required on every create/capture/refund so a retry cannot double-charge.
  idempotencyKey String @unique

  authorizationUrl String?
  failureReason    String?

  authorizedAt DateTime?
  capturedAt   DateTime?
  failedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  refunds  Refund[]
  webhooks PaymentWebhook[]

  @@index([orderId])
  @@index([status])
}

model Refund {
  id        String @id @default(cuid())
  paymentId String

  amount Int
  reason String
  status String @default("pending")

  providerReference String?
  idempotencyKey    String @unique

  requestedBy String
  approvedBy  String?
  approvedAt  DateTime?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
}

model PaymentWebhook {
  id        String  @id @default(cuid())
  paymentId String?

  provider String
  // The provider's own event id. Unique, so a replayed webhook is a no-op
  // rather than a second capture.
  eventId  String
  eventType String

  signatureValid Boolean
  processedAt    DateTime?
  processingError String?

  // Raw body retained for dispute evidence and replay debugging.
  rawPayload String

  receivedAt DateTime @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, eventId])
  @@index([processedAt])
}

// ===========================================================================
// Ledger — append-only. No updates, no deletes, ever.
// ===========================================================================

model LedgerTransaction {
  id   String @id @default(cuid())
  kind String

  idempotencyKey String @unique

  referenceType String
  referenceId   String

  actorId String
  note    String?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([kind, occurredAt])
}

model LedgerEntry {
  id            String @id @default(cuid())
  transactionId String

  accountKind String
  ownerId     String?

  // Signed, debit-positive. Entries in a transaction must sum to exactly zero;
  // this is asserted in code before the write and by a nightly reconciliation.
  amount Int
  memo   String

  createdAt DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])

  @@index([accountKind, ownerId])
  @@index([transactionId])
}

// ===========================================================================
// Promotions, loyalty, subscriptions
