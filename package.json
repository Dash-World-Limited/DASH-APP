{
  "name": "dash-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @dash/api",
    "dev:web": "npm run dev --workspace @dash/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate --workspace @dash/db",
    "db:push": "npm run push --workspace @dash/db",
    "db:seed": "npm run seed --workspace @dash/db",
    "db:reset": "npm run reset --workspace @dash/db",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
