{
  "name": "dash-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @dash/api",
    "dev:web": "npm run dev --workspace @dash/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --skip-generate --schema packages/db/prisma/schema.prisma",
    "db:reset": "prisma db push --force-reset --skip-generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema packages/db/prisma/schema.prisma",
    "db:pg:sync": "tsx scripts/sync-postgres-schema.mjs",
    "db:pg:generate": "prisma generate --schema packages/db/prisma/postgres/schema.prisma",
    "db:pg:migrate": "prisma migrate deploy --schema packages/db/prisma/postgres/schema.prisma",
    "db:pg:migrate:dev": "prisma migrate dev --schema packages/db/prisma/postgres/schema.prisma",
    "db:pg:migrate:status": "prisma migrate status --schema packages/db/prisma/postgres/schema.prisma",
    "check:postgres": "tsx scripts/postgres-check.mjs",
    "check:redis": "tsx scripts/redis-check.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:keys": "tsx scripts/key-custody-check.mjs",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:seed:reference": "tsx packages/db/src/seed-reference.ts",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run db:seed",
    "clean": "node scripts/clean.mjs",
    "maintenance:retention": "tsx apps/api/src/jobs/run-retention.ts",
    "maintenance:accounts": "tsx apps/api/src/jobs/run-account-maintenance.ts",
    "maintenance:all": "tsx apps/api/src/jobs/run-maintenance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
