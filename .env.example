# =============================================================================
# DASH APP — environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every value below is a safe placeholder, not a working credential.
#
# HOW SECRETS REACH THE PROCESS
# -----------------------------
# In development, from this file. In staging and production, injected into the
# process environment by whatever platform runs the service — a Kubernetes
# secret projected as an env var, AWS Secrets Manager or GCP Secret Manager
# through the platform's own injection, Vault's agent, or a hosting provider's
# secret UI. The application cannot tell which, and must not try: `loadConfig`
# reads the environment and validates it, and that is the entire contract.
# No secret-store SDK is integrated, because no deployment platform has been
# chosen. See docs/DECISIONS.md ADR-0011.
#
# Every variable is classified secret or non-secret in
# `apps/api/src/secrets/classification.ts`. Secrets are redacted from every log,
# error, and health response, and `npm run check:secrets` fails if any secret
# below stops looking like a placeholder.
# =============================================================================

NODE_ENV=development

# --- Core -------------------------------------------------------------------
# Local dev uses SQLite (no install required). Production target is PostgreSQL
# + PostGIS; see docs/DECISIONS.md ADR-0003 for the migration path.
DATABASE_URL="file:./dev.db"
# Production example (do not use locally):
# DATABASE_URL="postgresql://dash_runtime:CHANGE_ME@localhost:5432/dash?schema=public"

API_PORT=4000
API_HOST=127.0.0.1
WEB_PORT=3000
PUBLIC_API_URL=http://127.0.0.1:4000
PUBLIC_WEB_URL=http://127.0.0.1:3000

# --- Auth -------------------------------------------------------------------
# SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# These MUST be different from each other: if they are equal, a refresh token
# verifies as an access token, which is a full authentication bypass that is
# invisible until someone tries it. Boot refuses equal values in every
# environment.
#
# They MUST also differ per environment. Development, staging, and production
# each get their own pair, generated separately. A staging secret that signs
# tokens production accepts makes staging access equal to production access.
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-access
JWT_REFRESH_SECRET=replace-me-with-48-random-bytes-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# OTP behaviour. DEV_EXPOSE_OTP is hard-blocked when NODE_ENV=production.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Per phone number or email address, whichever client asks: after a code is
# sent, nothing more is sent to that destination for the cooldown (production
# refuses less than 30 s), and at most OTP_MAX_CODES_PER_HOUR in any hour.
# Throttled requests get the same answer as any other and send nothing.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_CODES_PER_HOUR=5
DEV_EXPOSE_OTP=true

# --- Encryption at rest -----------------------------------------------------
# One keyring protects every encrypted field (the TOTP secret today, vendor
# bank details next). Fields are separated cryptographically rather than by
# holding separate keys: each ciphertext is bound to a purpose and a subject as
# additional authenticated data, so a TOTP envelope cannot be read as a bank
# account and one vendor's row cannot be decrypted as another's.
#
# Base64 of exactly 32 bytes. Generate your own — never reuse this placeholder,
# and never commit a real key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Production refuses to start without it.
#
# ENVIRONMENT SEPARATION IS NOT OPTIONAL. Development, staging, and production
# each hold their own key, and no key is ever copied between them. A staging key
# that decrypts production data makes staging access equal to production access,
# and staging is where the access controls are loosest by design.
#
# The key is also backed up SEPARATELY from the database. A database backup
# without the key restores unrecoverable ciphertext; a key stored beside the
# backup defeats the encryption entirely. See docs/KEY_MANAGEMENT.md.
ENCRYPTION_KEY=replace-me-with-32-random-bytes-base64-encoded=

# NOT secret — this identifier travels in plaintext inside every envelope the
# key writes, which is what lets a key be rotated without rewriting existing
# rows in one deploy. Limited to letters, digits, underscore, and hyphen: any
# other character cannot be parsed back out of an envelope, so boot refuses it.
ENCRYPTION_KEY_ID=k1

# SECRET. Keys that no longer encrypt new values but must still decrypt old
# ones. Format: id:base64key,id2:base64key2
#
# Removing an entry here while any stored row still names that key makes those
# rows permanently unreadable. `npm run check:keys` documents the rotation
# order; the survey in apps/api/src/secrets/rotation.ts is what tells you when
# removal is actually safe.
ENCRYPTION_KEYS_RETIRED=

# Administrator MFA. Staff roles must complete TOTP before receiving a session.
# Cannot be disabled in production.
MFA_ENABLED=true

# Every seeded staff account shares this fixed, fake TOTP secret in development
# so you can add it to an authenticator once. Never used outside the seed.
#   DEV_TOTP_SECRET = JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- Data retention ----------------------------------------------------------
# The housekeeping job (`npm run maintenance:retention`) applies the policy in
# packages/domain/src/retention. These override individual periods; unset means
# the policy default. Each is capped — shortening is always allowed, lengthening
# past the ceiling is refused at boot. See docs/RETENTION.md.
#
# NONE of these periods has been reviewed by qualified Nigerian privacy counsel.
# They are conservative engineering defaults, not a compliance statement.
#
# RETENTION_SESSIONS_DAYS=60         # delete expired sessions       (cap 180)
# RETENTION_RIDER_LOCATION_DAYS=90   # coarsen old tracking pings    (cap 365)
# RETENTION_OTP_DAYS=7               # delete spent OTP + MFA codes  (cap 30)
# RETENTION_IDEMPOTENCY_DAYS=30      # delete expired idempotency    (cap 90)

# --- Account deletion and data export -----------------------------------------
# How long a scheduled account deletion waits before the finalisation job
# anonymises it (default 14; range 1-90), and how long a built data-export
# archive stays downloadable (default 24; range 1-168). Both are validated
# against the domain policy at boot. See docs/RETENTION.md.
#
# ACCOUNT_DELETION_COOLING_OFF_DAYS=14
# DATA_EXPORT_TTL_HOURS=24

# --- Money / market ---------------------------------------------------------
# All money is integer minor units (kobo). Never floats.
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
DEFAULT_CITY_SLUG=lagos
DEFAULT_TIMEZONE=Africa/Lagos

# --- Payments (adapter) -----------------------------------------------------
# PROVIDER: `mock` (default, offline, deterministic) | `paystack`
# `paystack` talks to the real Paystack API (apps/api/src/adapters/paystack.ts).
# SECRET. Left empty on purpose: the real values carry Paystack's own
# `sk_test_` / `sk_live_` prefixes, and a placeholder wearing that prefix is
# indistinguishable from a leaked key to a secret scanner, a reviewer skimming
# a diff, or a search of this repository. Empty is unambiguous.
#
# Use the sk_test_ key everywhere. A sk_live_ key is refused unless
# NODE_ENV=production AND PAYSTACK_ALLOW_LIVE=true.
# Paystack signs webhooks with the secret key itself: leave
# PAYSTACK_WEBHOOK_SECRET empty (any different value is refused at boot).
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_ALLOW_LIVE=false
# Optional; defaults to PUBLIC_WEB_URL/pay/complete. Must be a full URL when set.
# PAYSTACK_CALLBACK_URL=https://dashworld.ng/pay/complete

# --- Deployment profile -----------------------------------------------------
#
# Which parts of DASH this deployment runs.
#
#   full        DASH APP. Payments, delivery, dispatch, SMS, push and maps.
#               Every strict production guard applies.
# Read by BOTH the API and the web process. `apps/web/src/middleware.ts` uses it to
# serve only the marketplace, its admin console and staff sign-in; every other
# DASH APP page answers 404 on that host.
#
# Read at run time in both, including the web middleware — confirmed by starting
# one build twice, with and without it. It is not inlined the way the
# NEXT_PUBLIC_* variables below are, so changing it needs a restart, not a
# rebuild.
#
#   declutters  The Declutters marketplace alone. Those capabilities are OFF:
#               their adapters throw on every call and their routes are never
#               registered, so nothing can be silently mocked. Email, object
#               storage, PostgreSQL/PostGIS and Redis are still required and
#               still guarded.
#
# Defaults to `full`, deliberately: a deployment that forgets to declare itself
# gets the strictest checks rather than the loosest.
#
# See apps/api/src/deployment/profile.ts.
DEPLOYMENT_PROFILE=full

# --- Maps (adapter) ---------------------------------------------------------
# PROVIDER: `local` (haversine + in-process geometry) | `google` | `mapbox`
MAPS_PROVIDER=local
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Notifications (adapter) ------------------------------------------------
# PROVIDER: `console` (logs only) | `termii` | `twilio`
SMS_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console
# SECRET. None of these is read by any code yet — Milestone III protects their
# future credentials, it does not integrate the providers (Phase 4 does).
TERMII_API_KEY=
TWILIO_AUTH_TOKEN=
SMTP_URL=
FCM_SERVICE_ACCOUNT_JSON=

# --- Object storage (adapter) -----------------------------------------------
# PROVIDER: `local` (./.storage) | `s3`
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=
S3_BUCKET=
# SECRET. Not read by any code yet.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Queue / cache (adapter) ------------------------------------------------
# PROVIDER: `memory` (in-process, dev) | `redis` (BullMQ)
QUEUE_PROVIDER=memory

# --- Realtime ---------------------------------------------------------------
# The WebSocket endpoint at GET /v1/realtime. Turning it off does not break
# any screen: every one of them reads its state from an ordinary authorized
# route and falls back to polling, which is what they all did before it
# existed. A disabled deployment closes each socket with code 4013 so a client
# stops retrying immediately instead of guessing.
REALTIME_ENABLED=true

# How a notification reaches the OTHER instances.
#   memory — repeats it inside this process only. Correct on one instance,
#            silently wrong on more: the customer watching an order is
#            connected to whichever instance the load balancer picked, and it
#            is rarely the one whose worker took the job. Refused in
#            production, like QUEUE_PROVIDER=memory.
#   redis  — Redis pub/sub. Needs REDIS_URL.
REALTIME_BROADCAST=memory

# --- PostgreSQL / PostGIS (production) --------------------------------------
# Development uses SQLite; production uses PostgreSQL. Prisma cannot switch a
# datasource provider at runtime, so the two live in separate schema files:
#   packages/db/prisma/schema.prisma           (sqlite, authored)
#   packages/db/prisma/postgres/schema.prisma  (postgresql, generated)
# Regenerate the second with `npm run db:pg:sync`; a test fails if it is stale.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
#
# Which implementation answers zone containment. `postgis` pushes the
# point-in-polygon test into the database as ST_Contains and requires the
# extension: CREATE EXTENSION IF NOT EXISTS postgis;
# Production refuses `local`; SQLite refuses `postgis`.
GEO_ZONES_PROVIDER=local

# --- Redis ------------------------------------------------------------------
# Never commit a real URL. A password belongs in the deployment's secret store.
#   REDIS_URL=redis://:PASSWORD@HOST:6379
#
# Share rate-limit counters through Redis. Off in development; production
# refuses `false`, because per-process counters multiply the real limit by the
# number of instances. When on, the limiter fails CLOSED — a Redis outage
# rejects traffic rather than silently removing the limit.
RATE_LIMIT_REDIS=false
REDIS_URL=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# SECRET. A DSN embeds a credential in its userinfo. Not read by any code yet.
ERROR_TRACKING_DSN=


# ============================================================================
# PRODUCTION: DASH World Declutters (profile `declutters`)
# ============================================================================
#
# The complete set for declutters.dashworldng.com. Nothing here is mocked: RDS,
# Redis, S3 and SES are all real. Payments, SMS, push, maps, delivery and data
# export are switched off, so no Paystack key, no maps key, no SMS provider and
# no FCM credential is needed — and none should be present, because an unused
# credential in a production environment is a liability with no upside.
#
# Do not copy this into a `full` deployment. Every provider left at its
# development value below is refused by the full profile, correctly.
#
# NODE_ENV=production
# DEPLOYMENT_PROFILE=declutters
#
# # --- Database: Amazon RDS, private, PostGIS installed ---------------------
# DATABASE_URL=postgresql://dashadmin:PASSWORD@dash-declutters-db.xxxx.eu-west-1.rds.amazonaws.com:5432/dashdb?sslmode=require
# GEO_ZONES_PROVIDER=postgis
#
# # --- Redis on the Lightsail instance --------------------------------------
# REDIS_URL=redis://127.0.0.1:6379
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REDIS=true
# QUEUE_PROVIDER=redis
#
# # --- Object storage: S3, private bucket -----------------------------------
# STORAGE_PROVIDER=s3
# S3_BUCKET=dash-declutters-prod-media
# S3_REGION=eu-west-1
#
# # --- Transactional email: SES ---------------------------------------------
# EMAIL_PROVIDER=ses
# SES_REGION=eu-west-1
# EMAIL_FROM_ADDRESS=no-reply@notify.dashworldng.com
# EMAIL_FROM_NAME=DASH World
# EMAIL_REPLY_TO=admin@dashworldng.com
# SES_CONFIGURATION_SET=dash-transactional
# SES_EVENT_TOPIC_ARN=arn:aws:sns:eu-west-1:ACCOUNT_ID:dash-email-events
#
# # --- AWS credentials ------------------------------------------------------
# # Lightsail instances cannot assume an IAM role, so keys are unavoidable here.
# # SECRET.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# # --- The SES sandbox gate -------------------------------------------------
# # Only these addresses may create an account. SES delivers only to verified
# # addresses while sandboxed and silently drops the rest, so without this
# # signup hands somebody an account whose code never arrives. Clear it once
# # production access is granted. SECRET: real addresses.
# SIGNUP_ALLOWLIST=
#
# # --- Secrets --------------------------------------------------------------
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# ENCRYPTION_KEY=
#
# PUBLIC_WEB_URL=https://declutters.dashworldng.com
# API_PORT=4000
# VALUECHECK_PROVIDER=local
#
# # --- Deliberately absent --------------------------------------------------
# # PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET, GOOGLE_MAPS_API_KEY,
# # TERMII_API_KEY, TWILIO_AUTH_TOKEN, FCM_SERVICE_ACCOUNT_JSON.
# # The capabilities that use them are off. Their adapters throw and their
# # routes answer 404.
# #
# # Also absent: REALTIME_ENABLED and REALTIME_BROADCAST. Realtime is a capability
# # this profile does not have, so no socket is served and the guard against
# # in-memory fan-out does not apply. REALTIME_ENABLED=true does not re-enable it
# # — the socket closes with the "disabled" code.
#
# # --- Web (apps/web) -------------------------------------------------------
# # The NEXT_PUBLIC_* three are inlined by `next build`; set them in the build
# # environment or they have no effect. DEPLOYMENT_PROFILE is read at run time by
# # the middleware and belongs in the web process's environment too.
# DEPLOYMENT_PROFILE=declutters
# NEXT_PUBLIC_API_URL=https://api.dashworldng.com
# NEXT_PUBLIC_SITE_ORIGIN=https://declutters.dashworldng.com
# NEXT_PUBLIC_DECLUTTER_INDEXABLE=false
